# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, sitemap.xml and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email delivery -------------------------------------------
# Which provider handles contact form submissions.
#   console  -> logs the inquiry to the server console (default, no setup)
#   resend   -> sends email through Resend (requires RESEND_API_KEY)
CONTACT_PROVIDER=console

# Required only when CONTACT_PROVIDER=resend
RESEND_API_KEY=
# Verified sender address on your Resend domain
CONTACT_FROM_EMAIL=website@example.com
# Where inquiries are delivered
CONTACT_TO_EMAIL=hello@example.com

# --- Analytics (optional) ---------------------------------------------------
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
