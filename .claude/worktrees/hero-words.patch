+/* Hero logo loops, once the pieces have landed (about 1.5s in).
+   `mark-word`: the eight words in the P's counter take turns, 2.5s each, so
+   the 20s cycle gives each one 12.5%: rise in, hold, rise out. The
+   percentages assume exactly eight words (`heroMarkWords` is typed to eight).
+   `mark-ticker`: the leg's text is written twice, so sliding it by half its
+   own width (fill-box) loops without a seam. Both pause with the logo's pause
+   button (`data-motion="paused"`, set by MarkMotion). */
+@keyframes mark-word {
+  0% {
+    opacity: 0;
+    transform: translateY(14px);
+  }
+  2.5%,
+  10.5% {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  12.5%,
+  100% {
+    opacity: 0;
+    transform: translateY(-14px);
+  }
+}
+
+@keyframes mark-ticker {
+  to {
+    transform: translateX(-50%);
+  }
+}
+
+[data-cycle] {
+  animation: mark-word 20s var(--ease-out-soft) infinite both;
+  animation-delay: calc(1600ms + var(--i, 0) * 2500ms);
+}
+
+[data-ticker] {
+  white-space: pre;
+  transform-box: fill-box;
+  animation: mark-ticker 32s linear infinite;
+}
+
+[data-motion="paused"] :is([data-cycle], [data-ticker]) {
+  animation-play-state: paused;
+}
