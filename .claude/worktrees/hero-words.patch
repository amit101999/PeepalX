index 0000000..9073cc7
--- /dev/null
+++ b/src/components/sections/hero/MarkMotion.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { Pause, Play } from "lucide-react";
+import { useState, useSyncExternalStore, type ReactNode } from "react";
+import { usePrefersReducedMotion } from "@/lib/hooks/use-prefers-reduced-motion";
+
+/**
+ * Holds the hero logo and the button that pauses its looping motion (the
+ * words in the P and the ticker along the X).
+ *
+ * The loops run for as long as the page is open, so WCAG 2.2.2 asks for a way
+ * to stop them. The animation itself stays pure CSS: this component only flips
+ * `data-motion`, and globals.css sets `animation-play-state` from it. The logo
+ * is passed in as children, so it stays server-rendered.
+ */
+export function MarkMotion({
+  children,
+  className,
+}: {
+  children: ReactNode;
+  className?: string;
+}) {
+  const [paused, setPaused] = useState(false);
+  const prefersReducedMotion = usePrefersReducedMotion();
+  // The button appears only on the client, where the motion preference is known.
+  const mounted = useSyncExternalStore(
+    noopSubscribe,
+    () => true,
+    () => false,
+  );
+
+  const label = paused ? "Play the logo animation" : "Pause the logo animation";
+  const Icon = paused ? Play : Pause;
+
+  return (
+    <div data-motion={paused ? "paused" : "running"} className={className}>
+      {children}
+      {mounted && !prefersReducedMotion ? (
+        <button
+          type="button"
+          onClick={() => setPaused((current) => !current)}
+          aria-label={label}
+          className="absolute right-0 bottom-0 inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-tint hover:text-ink"
+        >
+          <Icon aria-hidden="true" className="size-4" />
+        </button>
+      ) : null}
+    </div>
+  );
+}
+
+function noopSubscribe() {
+  return () => {};
+}
